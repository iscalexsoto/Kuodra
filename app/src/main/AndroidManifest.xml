<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Escaneo de tickets (la galería usa el Photo Picker: no requiere permiso). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".KuodraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kuodra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kuodra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link de redirect de OAuth2 (login con Google). Host/ruta vienen de
                 `oauth.redirect.url` (local.properties) vía manifestPlaceholders. autoVerify
                 exige servir /.well-known/assetlinks.json en el dominio (ver docs/POCKETBASE.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${oauthRedirectHost}"
                    android:path="${oauthRedirectPath}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.Kuodra" />
    </application>

</manifest>